; Ironhaven — Godot 4 vertical slice (Nordic summer harbour). See SHARED_CONTEXT.md.
config_version=5

[application]
config/name="Ironhaven"
config/description="Nordic summer harbour vertical slice"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

[dotnet]
project/assembly_name="Ironhaven"

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128
